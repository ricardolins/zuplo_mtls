# Certificate Service backend URL (your LKE ingress)
CERT_SERVICE_URL=https://certs.ricardolins.dev.br

# Backend BaaS API URL (proxied via /v1/api/*)
BACKEND_API_URL=https://your-backend-api.example.com

# Step-CA OCSP endpoint (optional, for real-time cert revocation checks)
OCSP_URL=http://certs.ricardolins.dev.br:8080
